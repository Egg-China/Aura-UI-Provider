{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aura Modern UI",
  "version": "0.1.0",
  "identifier": "dev.aura.modern-ui",
  "build": {
    "frontendDist": "../frontend/dist",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aura Launcher Modern",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
